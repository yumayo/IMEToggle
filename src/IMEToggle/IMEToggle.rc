#include <winresrc.h>

1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "IMEToggle - F13 IME OFF / F14 IME ON\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "IMEToggle\0"
            VALUE "OriginalFilename", "IMEToggle.exe\0"
            VALUE "ProductName", "IMEToggle\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
